# Copy to .env and fill in only what you need. .env is ignored by git; values are never logged.
# NASA Open APIs key (https://api.nasa.gov) — optional, DEMO_KEY is used otherwise (rate-limited)
NASA_API_KEY=
# Optional: free-form questions in the AI route assistant (module 07). Without it the assistant
# still explains routes from the computed numbers only.
ANTHROPIC_API_KEY=
MARS_LLM_MODEL=claude-sonnet-5-5
